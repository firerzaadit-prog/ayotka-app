# Salin file ini menjadi .env dan isi nilainya secara lokal.
# JANGAN PERNAH commit file .env (hanya .env.example yang boleh masuk git).

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AyoTKA
NODE_ENV=development

# --- Database (Supabase Postgres, lewat Prisma) ---
# Connection string dari dashboard Supabase > Project Settings > Database
DATABASE_URL=

# --- Supabase (Auth + Storage + Database) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: HANYA dipakai di server (Admin API). Jangan pernah
# expose ke browser atau prefix dengan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis ---
# Tidak dipakai - keputusan Fase 5: analisis AI dipicu manual oleh admin,
# bukan job otomatis massal, jadi antrean Redis/BullMQ tidak jadi kebutuhan.
# Dibiarkan di sini kalau nanti butuh lagi untuk kebutuhan lain.
REDIS_URL=

# --- AI (Fase 5, provider Gemini) ---
# API key gratis dari https://aistudio.google.com/apikey
AI_API_KEY=
# Opsional - nama model Gemini. Google kadang pensiunkan model lama;
# kalau tombol "Mulai Analisis AI" error 404 menyebut model tidak
# ditemukan, isi env var ini dengan nama model pengganti yang disebut
# di pesan errornya (tidak perlu ubah kode). Default: gemini-3.6-flash.
AI_MODEL=

# --- Email billing H-7/H-3/H-0 (Fase 6) ---
# Bukan untuk verifikasi email/reset password - itu ditangani Supabase Auth langsung.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=

# --- Seed Admin Pusat pertama (HANYA untuk prisma/seed.ts, Tiket 1.2b) ---
# Minimal 16 karakter, jangan pola kata+tahun. Isi nilai asli hanya di .env
# lokal - jangan pernah ditulis di kode, commit, atau percakapan dengan AI.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
