# Salin file ini menjadi .env dan isi nilainya secara lokal.
# JANGAN PERNAH commit file .env (hanya .env.example yang boleh masuk git).

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AyoTKA
NODE_ENV=development

# --- Database (Supabase Postgres, lewat Prisma) ---
# Connection string dari dashboard Supabase > Project Settings > Database
DATABASE_URL=
# Opsional - default 1 (lihat lib/db/prisma.ts). Cuma naikkan kalau load
# test (scripts/load-test) membuktikan 1 jadi bottleneck nyata, bukan asumsi.
DATABASE_CONNECTION_LIMIT=

# --- Impor Bank Soal TKA dari soal.ayotka.id (Fase 2) ---
# Koneksi baca-saja terpisah, lewat role khusus ayotka_app_reader yang cuma
# di-GRANT SELECT ke soal.questions, soal.stimulus, soal.question_packages
# (bukan DATABASE_URL biasa - sengaja role berbeda & lebih terbatas).
# Connection string dari pemilik soal.ayotka.id, format:
# postgresql://ayotka_app_reader:<password>@<host>:5432/postgres
SOAL_SOURCE_DATABASE_URL=

# --- Supabase (Auth + Storage + Database) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: HANYA dipakai di server (Admin API). Jangan pernah
# expose ke browser atau prefix dengan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis ---
# Tidak dipakai. Antrean Analisis AI (lib/ai/queue-worker.ts) sekarang
# berbasis kolom database + Vercel Cron per menit (lihat CRON_SECRET di
# bawah, dan vercel.json) - cukup untuk laju panggilan Gemini yang dibatasi
# beberapa per detik, tidak perlu Redis/BullMQ. Dibiarkan di sini kalau nanti
# butuh lagi untuk kebutuhan lain (mis. real-time/pub-sub).
REDIS_URL=

# --- Cron antrean Analisis AI (app/api/cron/proses-antrean-ai) ---
# String acak bebas (mis. `openssl rand -hex 32`). Harus diisi SAMA PERSIS
# di Vercel > Settings > Environment Variables - Vercel otomatis mengirim
# header ini ("Authorization: Bearer <CRON_SECRET>") di setiap pemanggilan
# cron terjadwal, dipakai endpoint untuk menolak pemanggilan dari luar.
CRON_SECRET=

# --- AI (Fase 5, provider Gemini) ---
# API key gratis dari https://aistudio.google.com/apikey
AI_API_KEY=
# Opsional - nama model Gemini. Google kadang pensiunkan model lama;
# kalau tombol "Mulai Analisis AI" error 404 menyebut model tidak
# ditemukan, isi env var ini dengan nama model pengganti yang disebut
# di pesan errornya (tidak perlu ubah kode). Default: gemini-3.6-flash.
AI_MODEL=

# --- Email konfirmasi registrasi siswa mandiri (lewat Resend HTTP API) ---
# Awalnya email konfirmasi ditangani Supabase Auth langsung (SMTP custom di
# dashboard Supabase). Ternyata integrasi SMTP custom Supabase->Resend gagal
# konsisten (terverifikasi: panggilan langsung ke Resend berhasil, tapi
# lewat Supabase tidak pernah sampai ke Resend sama sekali - dicek dari log
# Resend yang tidak pernah bertambah). Sekarang kita generate link
# konfirmasinya lewat Supabase (auth.admin.generateLink, tetap aman/token
# resmi Supabase), tapi KIRIM emailnya sendiri lewat API Resend di sini.
# API key dari https://resend.com/api-keys (butuh domain terverifikasi).
RESEND_API_KEY=
RESEND_FROM_EMAIL="AyoTKA <noreply@ayotka.id>"

# --- Email billing H-7/H-3/H-0 (Fase 6) ---
# Ini SMTP terpisah (nodemailer), khusus buat email pengingat langganan -
# beda dari RESEND_API_KEY di atas yang khusus konfirmasi registrasi.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=

# --- Midtrans (Jalur A - siswa individu, lihat lib/billing/midtrans.ts) ---
# Server key & client key dari dashboard.sandbox.midtrans.com (buat akun
# sandbox dulu, gratis) untuk pengembangan, atau dashboard.midtrans.com
# untuk produksi. MIDTRANS_IS_PRODUCTION=true HANYA setelah akun production
# disetujui Midtrans.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# --- Seed Admin Pusat pertama (HANYA untuk prisma/seed.ts, Tiket 1.2b) ---
# Minimal 16 karakter, jangan pola kata+tahun. Isi nilai asli hanya di .env
# lokal - jangan pernah ditulis di kode, commit, atau percakapan dengan AI.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
