// Skema data AyoTKA — mengikuti Brief Produk v1.9 Bagian 6 "Model Data" dan
// Bagian 6.1 (mesin skoring) & 7.1 (subscriptions/usage_counters).
//
// Konvensi: nama field di sini camelCase (idiomatik Prisma/TypeScript), tapi
// setiap field & tabel di-@map/@@map ke nama snake_case PERSIS seperti di
// brief, supaya kolom & tabel sungguhan di database tetap identik dengan
// Bagian 6 — bisa dibandingkan baris per baris di level SQL/migration.
//
// Semua id pakai uuid (cocok dengan auth.users.id milik Supabase Auth, yang
// dipakai langsung sebagai users.id — lihat Tiket 1.2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Grup 1-4: users, schools, subjects, school_users, academic_years, classes
// ---------------------------------------------------------------------------

enum Role {
  siswa
  admin_sekolah
  admin_pusat
  dinas_pendidikan
  mitra
}

enum UserStatus {
  aktif
  nonaktif
}

/// id = Supabase Auth user id; password & hashing dikelola Supabase Auth,
/// tidak disimpan di sini. Akun NISN pakai email sintetis
/// {nisn}@nisn.ayotka.id, tidak pernah ditampilkan ke user (lihat Bagian 3.1).
model User {
  id              String     @id @db.Uuid
  email           String     @unique
  username        String?    @unique
  role            Role
  status          UserStatus @default(aktif)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")

  schoolUsers          SchoolUser[]
  studentProfile       Student?
  partnerProfile       Partner?
  waliKelasOf          Class[]           @relation("ClassWaliKelas")
  createdQuestions     Question[]        @relation("QuestionCreatedBy")
  vouchersGenerated    Voucher[]         @relation("VoucherGeneratedBy")
  schoolSeatsActivated School[]          @relation("SchoolSeatActivatedBy")
  loginLogs            LoginLog[]
  auditLogs            AuditLog[]
  taxonomyMappingsMade TaxonomyMapping[] @relation("TaxonomyMappingCreatedBy")
  soalImportsPerformed SoalImportLog[]   @relation("SoalImportLogImportedBy")

  @@map("users")
}

enum SchoolStatus {
  pending_verifikasi
  aktif
  suspend
}

model School {
  id                  String       @id @default(uuid()) @db.Uuid
  npsn                String?      @unique
  nama                String
  jenjang             Jenjang
  alamat              String?
  kodeSekolah         String       @unique @map("kode_sekolah")
  status              SchoolStatus @default(pending_verifikasi)
  /// Bagian 5 Jalur B: kuota kursi & masa berlaku diaktifkan manual oleh
  /// admin pusat setelah transfer dikonfirmasi di luar sistem — bukan hasil
  /// checkout mandiri. seatQuota null berarti belum pernah diaktifkan.
  seatQuota           Int?         @map("seat_quota")
  validUntil          DateTime?    @map("valid_until")
  seatActivatedById   String?      @map("seat_activated_by_id") @db.Uuid
  /// Bagian 4.1: rujukan mitra WAJIB dicatat sebelum seatQuota diaktifkan,
  /// bukan sesudah — lihat lib/billing/partner-commission.ts.
  referredByPartnerId String?      @map("referred_by_partner_id") @db.Uuid

  schoolUsers           SchoolUser[]
  classes               Class[]
  students              Student[]
  packageVisibility     PackageVisibility[]
  tryOutGroupVisibility TryOutGroupVisibility[]
  assignments           Assignment[]
  seatActivatedBy       User?                   @relation("SchoolSeatActivatedBy", fields: [seatActivatedById], references: [id], onDelete: SetNull)
  referredByPartner     Partner?                @relation(fields: [referredByPartnerId], references: [id], onDelete: SetNull)
  entitlements          Entitlement[]
  partnerCommissions    PartnerCommission[]

  @@map("schools")
}

enum Jenjang {
  SD
  SMP
}

model Subject {
  id      String  @id @default(uuid()) @db.Uuid
  kode    String  @unique
  nama    String
  jenjang Jenjang

  materi       Materi[]
  blueprints   Blueprint[]
  packages     Package[]
  plans        Plan[]
  invoices     Invoice[]
  tryOutGroups TryOutGroup[]

  @@map("subjects")
}

/// Admin sekolah (tidak ada sub-peran guru terpisah — lihat keputusan #11 brief).
model SchoolUser {
  userId   String  @map("user_id") @db.Uuid
  schoolId String  @map("school_id") @db.Uuid
  subRole  String? @map("sub_role")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([userId, schoolId])
  @@map("school_users")
}

model AcademicYear {
  id       String   @id @default(uuid()) @db.Uuid
  nama     String
  mulai    DateTime
  selesai  DateTime
  isActive Boolean  @default(false) @map("is_active")

  classes            Class[]
  studentEnrollments StudentEnrollment[]

  @@map("academic_years")
}

model Class {
  id             String  @id @default(uuid()) @db.Uuid
  schoolId       String  @map("school_id") @db.Uuid
  academicYearId String  @map("academic_year_id") @db.Uuid
  tingkat        Int
  namaRombel     String  @map("nama_rombel")
  waliKelasId    String? @map("wali_kelas_id") @db.Uuid

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  waliKelas          User?               @relation("ClassWaliKelas", fields: [waliKelasId], references: [id], onDelete: SetNull)
  assignments        Assignment[]
  studentEnrollments StudentEnrollment[]

  /// Tiket 3.6: cegah rombel duplikat (nama sama, tingkat sama) dalam satu
  /// sekolah pada tahun ajaran yang sama - juga dipakai sebagai target
  /// upsert saat Naik Kelas massal membuat/menemukan kelas tujuan.
  @@unique([schoolId, academicYearId, tingkat, namaRombel])
  @@map("classes")
}

// ---------------------------------------------------------------------------
// Grup 5-7: materi -> sub_materi -> kompetensi
// ---------------------------------------------------------------------------

model Materi {
  id        String  @id @default(uuid()) @db.Uuid
  subjectId String  @map("subject_id") @db.Uuid
  jenjang   Jenjang
  tingkat   Int
  nama      String
  urutan    Int

  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  subMateri SubMateri[]

  @@map("materi")
}

model SubMateri {
  id       String @id @default(uuid()) @db.Uuid
  materiId String @map("materi_id") @db.Uuid
  nama     String
  urutan   Int

  materi     Materi       @relation(fields: [materiId], references: [id], onDelete: Restrict)
  kompetensi Kompetensi[]

  @@map("sub_materi")
}

enum LevelKognitif {
  L1
  L2
  L3
}

model Kompetensi {
  id            String        @id @default(uuid()) @db.Uuid
  subMateriId   String        @map("sub_materi_id") @db.Uuid
  kode          String
  deskripsi     String
  levelKognitif LevelKognitif @map("level_kognitif")

  subMateri        SubMateri         @relation(fields: [subMateriId], references: [id], onDelete: Restrict)
  blueprintItems   BlueprintItem[]
  questions        Question[]
  competencyScores CompetencyScore[]
  taxonomyMappings TaxonomyMapping[]

  @@map("kompetensi")
}

// ---------------------------------------------------------------------------
// Grup 8: students, student_enrollments
// ---------------------------------------------------------------------------

enum Jalur {
  A
  B
}

enum ClaimStatus {
  belum_klaim
  sudah_klaim
}

enum StudentStatus {
  pending
  active
  nonaktif
}

model Student {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String?       @unique @map("user_id") @db.Uuid
  schoolId            String?       @map("school_id") @db.Uuid
  nisn                String?       @unique
  nama                String
  jenjang             Jenjang
  tingkat             Int
  jalur               Jalur
  claimToken          String?       @unique @map("claim_token")
  claimStatus         ClaimStatus   @default(belum_klaim) @map("claim_status")
  tanggalLahir        DateTime?     @map("tanggal_lahir") @db.Date
  status              StudentStatus @default(pending)
  waKontak            String?       @map("wa_kontak")
  /// Kode dibagikan siswa ke calon siswa baru, dipakai saat registrasi
  /// mandiri untuk mengisi referredByStudentId (app/api/registrasi/mandiri).
  referralCode        String        @unique @map("referral_code")
  /// Bagian 3 & 6.4: diskon referral 30% hanya berlaku untuk transaksi
  /// pertama siswa yang direferensikan, dan dibatasi jumlah maksimum per
  /// bulan per referrer (kasus tepi #4) — lihat app/api/siswa/checkout/route.ts.
  referredByStudentId String?       @map("referred_by_student_id") @db.Uuid
  /// Kode referral MITRA yang ditulis siswa saat daftar mandiri (kolom kode
  /// referral di halaman pendaftaran menerima kode teman ATAU kode mitra).
  /// Hanya pencatatan asal siswa - mitra melihat jumlahnya di dashboard,
  /// bukan identitas siswa (lihat app/mitra/(dashboard)/dashboard).
  referredByPartnerId String?       @map("referred_by_partner_id") @db.Uuid
  /// Bagian 7.2: soal & siswa tidak boleh dihapus permanen, hanya soft delete.
  deletedAt           DateTime?     @map("deleted_at")

  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  school            School?             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  referredBy        Student?            @relation("StudentReferral", fields: [referredByStudentId], references: [id], onDelete: SetNull)
  referrals         Student[]           @relation("StudentReferral")
  referredByPartner Partner?            @relation("StudentPartnerReferral", fields: [referredByPartnerId], references: [id], onDelete: SetNull)
  enrollments       StudentEnrollment[]
  attempts          Attempt[]
  invoices          Invoice[]
  entitlements      Entitlement[]
  vouchersUsed      Voucher[]
  saldoTransactions SaldoTransaction[]

  @@index([referredByPartnerId])
  @@map("students")
}

/// Dipakai untuk kenaikan kelas: setiap tahun ajaran baru = 1 enrollment baru,
/// riwayat enrollment tahun sebelumnya tetap tersimpan (Bagian 4 brief, tombol
/// "Naik Kelas").
model StudentEnrollment {
  studentId      String @map("student_id") @db.Uuid
  classId        String @map("class_id") @db.Uuid
  academicYearId String @map("academic_year_id") @db.Uuid

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  @@id([studentId, classId, academicYearId])
  @@unique([studentId, academicYearId])
  @@map("student_enrollments")
}

// ---------------------------------------------------------------------------
// Grup 9-14: blueprints, blueprint_items, packages, package_visibility,
// questions, question_options/categories/statements
// ---------------------------------------------------------------------------

model Blueprint {
  id          String  @id @default(uuid()) @db.Uuid
  subjectId   String  @map("subject_id") @db.Uuid
  jenjang     Jenjang
  /// Bisa lebih dari satu tingkat (mis. kisi-kisi yang sama dipakai kelas 7 & 8
  /// sekaligus) - sama pola dengan Package.tingkatList. Dulu kolom "tingkat"
  /// Int tunggal.
  tingkatList Int[]   @map("tingkat_list")
  nama        String
  totalSoal   Int     @map("total_soal")

  subject  Subject         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  items    BlueprintItem[]
  packages Package[]

  @@map("blueprints")
}

enum TingkatKesulitan {
  mudah
  sedang
  sulit
}

enum QuestionFormat {
  pg
  pg_kompleks
  pg_kategori
}

model BlueprintItem {
  id               String           @id @default(uuid()) @db.Uuid
  blueprintId      String           @map("blueprint_id") @db.Uuid
  kompetensiId     String           @map("kompetensi_id") @db.Uuid
  tingkatKesulitan TingkatKesulitan @map("tingkat_kesulitan")
  formatSoal       QuestionFormat   @map("format_soal")
  jumlahSoal       Int              @map("jumlah_soal")

  blueprint  Blueprint  @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  kompetensi Kompetensi @relation(fields: [kompetensiId], references: [id], onDelete: Restrict)

  @@map("blueprint_items")
}

enum OwnerType {
  pusat
  sekolah
}

enum TipePaket {
  paralel
  bertingkat
}

enum ModePembahasan {
  langsung
  setelah_tutup
}

enum PackageStatus {
  draft
  published
  archived
}

enum TargetSiswa {
  sekolah
  mandiri
  semua
}

/// Bagian 8/10 (permintaan user): "Try Out" resmi (skor + peta kompetensi +
/// analisis AI, biasanya dijadwalkan lewat bukaMulai/bukaSelesai) vs
/// "Latihan" (skor + peta kompetensi saja, TANPA analisis AI sama sekali,
/// berlaku di semua jalur - lihat lib/ai/auto-trigger.ts &
/// app/api/attempts/[id]/analisis-ai/route.ts). Default "tryout" supaya
/// paket lama yang sudah ada tetap berperilaku persis seperti sebelum
/// kolom ini ada.
enum JenisPaket {
  tryout
  latihan
}

/// Bagian B/F/G (permintaan user): kategori Try Out yang siswa lihat sebagai
/// dua menu terpisah dengan ikon masing-masing - "nasional" (dijadwalkan
/// admin pusat, dipooling+diacak lewat TryOutGroup, kuota & analisis AI-nya
/// otomatis termasuk sesuai plan) vs "mandiri" (kapan saja, sepuasnya,
/// Learning Analytics opsional per percobaan). Default "mandiri" supaya
/// paket/grup yang sudah ada tidak berubah perilaku.
enum TryOutKategori {
  mandiri
  nasional
}

model Package {
  id                String         @id @default(uuid()) @db.Uuid
  ownerType         OwnerType      @map("owner_type")
  ownerId           String         @map("owner_id") @db.Uuid
  subjectId         String         @map("subject_id") @db.Uuid
  jenjang           Jenjang
  /// Bisa lebih dari satu tingkat (mis. paket yang sama dipakai kelas 7 & 8
  /// sekaligus) - dulu kolom "tingkat" Int tunggal, diganti array supaya satu
  /// paket bisa menjangkau beberapa tingkat tanpa harus diduplikasi jadi
  /// beberapa paket identik. Selalu non-kosong (divalidasi di packageCreateSchema).
  tingkatList       Int[]          @map("tingkat_list")
  nama              String
  durasiMenit       Int            @map("durasi_menit")
  jumlahSoal        Int            @map("jumlah_soal")
  acakSoal          Boolean        @default(true) @map("acak_soal")
  acakOpsi          Boolean        @default(true) @map("acak_opsi")
  maxAttempt        Int?           @map("max_attempt")
  tipePaket         TipePaket      @default(paralel) @map("tipe_paket")
  jenisPaket        JenisPaket     @default(tryout) @map("jenis_paket")
  kategori          TryOutKategori @default(mandiri)
  /// Jendela pengerjaan untuk paket self-select (siswa mandiri & siswa
  /// sekolah lewat Latihan Mandiri) - dicek di getSelfSelectPackagesFor.
  /// Null berarti selalu terbuka (perilaku lama, dipakai default untuk
  /// paket Latihan yang memang tidak butuh jadwal). Sengaja tanggal
  /// mulai/selesai bebas (bukan enum mode) supaya admin pusat bisa
  /// menyetel "serentak" (rentang 1 hari) atau "seminggu" cukup dengan
  /// mengatur rentang tanggalnya sendiri, tanpa field mode terpisah.
  bukaMulai         DateTime?      @map("buka_mulai")
  bukaSelesai       DateTime?      @map("buka_selesai")
  blueprintId       String?        @map("blueprint_id") @db.Uuid
  bolehDipilihSiswa Boolean        @default(false) @map("boleh_dipilih_siswa")
  targetSiswa       TargetSiswa    @default(semua) @map("target_siswa")
  modePembahasan    ModePembahasan @default(setelah_tutup) @map("mode_pembahasan")
  status            PackageStatus  @default(draft)
  publishedAt       DateTime?      @map("published_at")
  /// Bagian 8/10 (permintaan user, "paket soal yang banyak, diacak"): kalau
  /// diisi, paket ini adalah salah satu VARIASI dari TryOutGroup - tidak
  /// pernah ditampilkan sendiri-sendiri ke siswa (bolehDipilihSiswa selalu
  /// false untuk variasi), hanya grupnya yang tampil. Sistem memilih satu
  /// variasi published SECARA ACAK per siswa saat attempt dibuat (lihat
  /// app/api/siswa/attempts/route.ts) - semua siswa yang mengikuti grup yang
  /// sama dirangking bareng meskipun dapat variasi paket yang berbeda-beda
  /// (lihat lib/exam/ranking.ts).
  tryOutGroupId     String?        @map("try_out_group_id") @db.Uuid

  subject       Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  blueprint     Blueprint?          @relation(fields: [blueprintId], references: [id], onDelete: SetNull)
  tryOutGroup   TryOutGroup?        @relation(fields: [tryOutGroupId], references: [id], onDelete: Cascade)
  questions     Question[]
  visibility    PackageVisibility[]
  assignments   Assignment[]
  attempts      Attempt[]
  soalImportLog SoalImportLog?

  @@map("packages")
}

/// Bagian 8/10 (permintaan user): satu "Try Out" yang siswa lihat sebagai
/// SATU entri, dibungkus dari beberapa Package "variasi" (soal berbeda,
/// setting jadwal/target sama - lihat Package.tryOutGroupId). Dipisah dari
/// Package (bukan cukup field grouping di Package) supaya field jadwal/
/// target/visibility cukup diisi SEKALI oleh admin per Try Out, bukan
/// diulang identik di tiap variasi dan rawan tidak sinkron.
model TryOutGroup {
  id             String         @id @default(uuid()) @db.Uuid
  ownerType      OwnerType      @map("owner_type")
  ownerId        String         @map("owner_id") @db.Uuid
  subjectId      String         @map("subject_id") @db.Uuid
  jenjang        Jenjang
  tingkatList    Int[]          @map("tingkat_list")
  nama           String
  durasiMenit    Int            @map("durasi_menit")
  jumlahSoal     Int            @map("jumlah_soal")
  maxAttempt     Int?           @map("max_attempt")
  kategori       TryOutKategori @default(mandiri)
  targetSiswa    TargetSiswa    @default(semua) @map("target_siswa")
  modePembahasan ModePembahasan @default(setelah_tutup) @map("mode_pembahasan")
  status         PackageStatus  @default(draft)
  bukaMulai      DateTime?      @map("buka_mulai")
  bukaSelesai    DateTime?      @map("buka_selesai")
  publishedAt    DateTime?      @map("published_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  subject    Subject                 @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  packages   Package[]
  visibility TryOutGroupVisibility[]

  @@map("try_out_groups")
}

/// Sama persis polanya dengan PackageVisibility, untuk TryOutGroup.
model TryOutGroupVisibility {
  id         String           @id @default(uuid()) @db.Uuid
  groupId    String           @map("group_id") @db.Uuid
  targetType VisibilityTarget @map("target_type")
  schoolId   String?          @map("school_id") @db.Uuid

  group  TryOutGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  school School?     @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([groupId, targetType, schoolId])
  @@map("try_out_group_visibility")
}

enum VisibilityTarget {
  semua
  sekolah
  publik
}

/// Tidak pakai id surrogate: school_id nullable (hanya untuk target "sekolah")
/// sehingga tidak bisa jadi bagian primary key komposit (PK harus NOT NULL).
model PackageVisibility {
  id         String           @id @default(uuid()) @db.Uuid
  packageId  String           @map("package_id") @db.Uuid
  targetType VisibilityTarget @map("target_type")
  schoolId   String?          @map("school_id") @db.Uuid

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  school  School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([packageId, targetType, schoolId])
  @@map("package_visibility")
}

model Question {
  id               String           @id @default(uuid()) @db.Uuid
  packageId        String           @map("package_id") @db.Uuid
  format           QuestionFormat
  teks             String
  media            String?
  bobot            Int              @default(1)
  tingkatKesulitan TingkatKesulitan @map("tingkat_kesulitan")
  materiId         String?          @map("materi_id") @db.Uuid
  subMateriId      String?          @map("sub_materi_id") @db.Uuid
  kompetensiId     String           @map("kompetensi_id") @db.Uuid
  levelBloom       LevelKognitif    @map("level_bloom")
  pembahasan       String?
  /// Bacaan/data bersama (mis. teks bacaan Bahasa Indonesia) yang dipakai
  /// beberapa Question sekaligus - null untuk soal yang berdiri sendiri.
  stimulusId       String?          @map("stimulus_id") @db.Uuid
  createdBy        String           @map("created_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at")
  /// Bagian 7.2: soal yang sudah dijawab tidak boleh diedit/dihapus permanen,
  /// hanya diarsipkan (soft delete) — riwayat attempt tetap harus bisa dibuka.
  deletedAt        DateTime?        @map("deleted_at")

  package    Package    @relation(fields: [packageId], references: [id], onDelete: Restrict)
  kompetensi Kompetensi @relation(fields: [kompetensiId], references: [id], onDelete: Restrict)
  creator    User       @relation("QuestionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  stimulus   Stimulus?  @relation(fields: [stimulusId], references: [id], onDelete: SetNull)

  options        QuestionOption[]
  categories     QuestionCategory[]
  statements     QuestionStatement[]
  attemptAnswers AttemptAnswer[]

  @@map("questions")
}

/// Untuk format pg & pg_kompleks (media: gambar/rumus juga didukung per opsi).
model QuestionOption {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  label      String
  teks       String
  media      String?
  isCorrect  Boolean @default(false) @map("is_correct")
  urutan     Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_options")
}

/// Untuk format pg_kategori: kolom tabel, selalu Benar/Salah (maks 3
/// baris/soal ditegakkan di lapisan aplikasi — lihat Tiket 2.6).
model QuestionCategory {
  id         String @id @default(uuid()) @db.Uuid
  questionId String @map("question_id") @db.Uuid
  label      String
  urutan     Int

  question   Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  statements QuestionStatement[]

  @@map("question_categories")
}

/// Baris tabel pg_kategori.
model QuestionStatement {
  id                String  @id @default(uuid()) @db.Uuid
  questionId        String  @map("question_id") @db.Uuid
  teks              String
  media             String?
  correctCategoryId String  @map("correct_category_id") @db.Uuid
  urutan            Int

  question        Question                 @relation(fields: [questionId], references: [id], onDelete: Cascade)
  correctCategory QuestionCategory         @relation(fields: [correctCategoryId], references: [id], onDelete: Restrict)
  answers         AttemptAnswerStatement[]

  @@map("question_statements")
}

// ---------------------------------------------------------------------------
// Grup 15-17: assignments, attempts, attempt_answers, competency_scores,
// ai_analyses
// ---------------------------------------------------------------------------

model Assignment {
  id        String   @id @default(uuid()) @db.Uuid
  packageId String   @map("package_id") @db.Uuid
  classId   String?  @map("class_id") @db.Uuid
  schoolId  String?  @map("school_id") @db.Uuid
  mulai     DateTime
  selesai   DateTime
  isActive  Boolean  @default(true) @map("is_active")

  package  Package   @relation(fields: [packageId], references: [id], onDelete: Restrict)
  class    Class?    @relation(fields: [classId], references: [id], onDelete: Restrict)
  school   School?   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  attempts Attempt[]

  @@map("assignments")
}

enum AttemptStatus {
  berjalan
  paused
  selesai
  kedaluwarsa
}

model Attempt {
  id                     String        @id @default(uuid()) @db.Uuid
  studentId              String        @map("student_id") @db.Uuid
  packageId              String        @map("package_id") @db.Uuid
  assignmentId           String?       @map("assignment_id") @db.Uuid
  mulaiAt                DateTime      @map("mulai_at")
  selesaiAt              DateTime?     @map("selesai_at")
  status                 AttemptStatus @default(berjalan)
  sisaDetik              Int           @map("sisa_detik")
  skorMentah             Float?        @map("skor_mentah")
  skorAkhir              Float?        @map("skor_akhir")
  ip                     String?
  userAgent              String?       @map("user_agent")
  /// Tiket 4.13: hitung berapa kali siswa pindah tab/aplikasi lain selama
  /// attempt ini - dicatat untuk dipantau admin sekolah & admin pusat,
  /// bukan pembatas otomatis (tidak menggagalkan ujian sendirian).
  tabSwitchCount         Int           @default(0) @map("tab_switch_count")
  /// Guard "satu sesi aktif per attempt" (dulu Map in-memory di
  /// lib/exam/session-guard.ts) - disimpan di DB supaya konsisten lintas
  /// instance server (deployment serverless bisa multi-instance).
  activeTabToken         String?       @map("active_tab_token")
  activeTabLastSeen      DateTime?     @map("active_tab_last_seen")
  /// Guard "satu proses analisis AI per attempt" + pesan gagal terakhir
  /// (dulu Set/Map in-memory di lib/ai/analysis-guard.ts), alasan sama.
  aiAnalysisProcessingAt DateTime?     @map("ai_analysis_processing_at")
  aiAnalysisLastError    String?       @map("ai_analysis_last_error")
  /// Diisi HANYA saat analisis AI OTOMATIS (dipicu finalizeAttempt, bukan
  /// tombol manual admin) berhasil untuk attempt ini - dipakai menghitung
  /// jatah "maksimal N kali analisis otomatis per siswa per mata pelajaran"
  /// (lihat lib/ai/auto-trigger.ts). Sengaja terpisah dari keberadaan baris
  /// ai_analyses (yang bisa ditimpa ulang oleh trigger manual admin kapan
  /// saja) - begitu jatah terpakai, tetap terhitung terpakai walau baris
  /// ai_analyses attempt ini belakangan ditimpa manual oleh admin.
  aiAutoAnalysisAt       DateTime?     @map("ai_auto_analysis_at")
  /// Bagian D/G (permintaan user): opt-in "gunakan Learning Analytics untuk
  /// percobaan ini?" diisi SEKALI saat attempt dibuat (app/api/siswa/attempts).
  /// Untuk paket kategori "nasional" selalu dipaksa true (LA otomatis
  /// termasuk) - lihat lib/billing/plan-fitur.ts. Menggantikan perilaku lama
  /// "AI selalu otomatis jalan untuk semua try out non-free-trial".
  analisisAiDiminta      Boolean       @default(false) @map("analisis_ai_diminta")

  student    Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  package    Package     @relation(fields: [packageId], references: [id], onDelete: Restrict)
  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  answers          AttemptAnswer[]
  competencyScores CompetencyScore[]
  aiAnalysis       AiAnalysis?

  @@map("attempts")
}

model AttemptAnswer {
  id          String    @id @default(uuid()) @db.Uuid
  attemptId   String    @map("attempt_id") @db.Uuid
  questionId  String    @map("question_id") @db.Uuid
  jawabanJson Json?     @map("jawaban_json")
  skor        Float?
  skorMaks    Float     @map("skor_maks")
  ragu        Boolean   @default(false)
  answeredAt  DateTime? @map("answered_at")

  attempt          Attempt                  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         Question                 @relation(fields: [questionId], references: [id], onDelete: Restrict)
  statementAnswers AttemptAnswerStatement[]

  @@unique([attemptId, questionId])
  @@map("attempt_answers")
}

/// Pemetaan jawaban per baris pernyataan pg_kategori — dipisah dari
/// jawaban_json (yang tetap jadi sumber data utama) supaya correct_category_id
/// bisa direferensikan relasional untuk keperluan skoring/analitik.
model AttemptAnswerStatement {
  id              String @id @default(uuid()) @db.Uuid
  attemptAnswerId String @map("attempt_answer_id") @db.Uuid
  statementId     String @map("statement_id") @db.Uuid
  categoryId      String @map("category_id") @db.Uuid

  attemptAnswer AttemptAnswer     @relation(fields: [attemptAnswerId], references: [id], onDelete: Cascade)
  statement     QuestionStatement @relation(fields: [statementId], references: [id], onDelete: Restrict)

  @@unique([attemptAnswerId, statementId])
  @@map("attempt_answer_statements")
}

model CompetencyScore {
  id           String @id @default(uuid()) @db.Uuid
  attemptId    String @map("attempt_id") @db.Uuid
  kompetensiId String @map("kompetensi_id") @db.Uuid
  jmlBenar     Int    @map("jml_benar")
  jmlSoal      Int    @map("jml_soal")
  persentase   Float

  attempt    Attempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  kompetensi Kompetensi @relation(fields: [kompetensiId], references: [id], onDelete: Restrict)

  @@unique([attemptId, kompetensiId])
  @@map("competency_scores")
}

/// Bagian D/G: bagaimana analisis ini "dibayar" - jatah kuota plan (gratis
/// buat siswa, tidak ada transaksi saldo) atau didebit dari saldo karena
/// jatah plan-nya sudah habis. Lihat lib/billing/plan-fitur.ts.
enum AnalisisSumber {
  kuota
  saldo
}

model AiAnalysis {
  id          String         @id @default(uuid()) @db.Uuid
  attemptId   String         @unique @map("attempt_id") @db.Uuid
  versiPrompt String         @map("versi_prompt")
  model       String
  ringkasan   String
  detailJson  Json           @map("detail_json")
  sumber      AnalisisSumber @default(kuota)
  generatedAt DateTime       @default(now()) @map("generated_at")

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@map("ai_analyses")
}

/// Baris tunggal (id selalu "global") untuk pengaturan global yang admin
/// pusat bisa ubah lewat UI, tanpa perlu redeploy - dimulai dari batas
/// jatah analisis AI otomatis (lihat lib/ai/auto-trigger.ts). Kalau nanti
/// ada pengaturan global lain, tambahkan kolom baru di sini, bukan baris baru.
model AppSetting {
  id                            String @id @default("global")
  aiAutoAnalysisMaxPerSubject   Int    @default(3) @map("ai_auto_analysis_max_per_subject")
  /// Bagian D/G (permintaan user): harga jual satu Learning Analytics
  /// tambahan (di luar jatah plan), didebit dari saldo siswa - lihat
  /// lib/billing/saldo.ts. Admin pusat atur lewat halaman Wallet/Saldo.
  hargaLearningAnalytics        Int    @default(7500) @map("harga_learning_analytics")
  /// Bagian D (permintaan user): margin keuntungan per transaksi Learning
  /// Analytics tambahan — dipakai lib/billing/margin.ts saat menghitung
  /// harga jual ke siswa. Default 20% (siswa bayar 120% dari harga dasar).
  marginLearningAnalyticsPersen Int    @default(20) @map("margin_learning_analytics_persen")

  // Pengaturan AI (Google Gemini)
  geminiApiKeyEncrypted String? @map("gemini_api_key_encrypted")
  geminiModel           String? @default("gemini-3.6-flash") @map("gemini_model")

  // Pengaturan Midtrans Payment Gateway
  midtransServerKeyEncrypted String? @map("midtrans_server_key_encrypted")
  midtransClientKey          String? @map("midtrans_client_key")
  midtransIsProduction       Boolean @default(false) @map("midtrans_is_production")

  // Pengaturan Email Resend (Verifikasi Akun)
  resendApiKeyEncrypted String? @map("resend_api_key_encrypted")
  resendFromEmail       String? @map("resend_from_email")

  // Pengaturan Email SMTP (Billing / Notifikasi)
  smtpHost          String? @map("smtp_host")
  smtpPort          Int?    @map("smtp_port")
  smtpUser          String? @map("smtp_user")
  smtpPassEncrypted String? @map("smtp_pass_encrypted")

  // Pengaturan Maintenance Mode
  maintenanceMode         Boolean @default(false) @map("maintenance_mode")
  maintenanceBypassSecret String? @map("maintenance_bypass_secret")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ---------------------------------------------------------------------------
// Grup 18-20: bank_accounts, plans, invoices, entitlements, vouchers,
// partners, partner_commissions
//
// Spesifikasi Perbaikan: Keanggotaan & Pembayaran — AyoTKA. Tiga jalur
// pembayaran (A siswa individu via Midtrans, B sekolah via transfer manual +
// aktivasi admin, C mitra/reseller via voucher) masing-masing ditulis
// terpisah (lib/billing/jalur-a.ts, jalur-b.ts, jalur-c.ts) dan TIDAK saling
// memanggil fungsi checkout yang sama. entitlements adalah satu-satunya
// tabel yang dibaca untuk cek akses, lewat getActiveEntitlement()
// (lib/billing/entitlements.ts) — lihat dokumen rencana untuk detail lengkap.
// ---------------------------------------------------------------------------

model BankAccount {
  id            String  @id @default(uuid()) @db.Uuid
  namaBank      String  @map("nama_bank")
  nomorRekening String  @map("nomor_rekening")
  atasNama      String  @map("atas_nama")
  isActive      Boolean @default(true) @map("is_active")

  @@map("bank_accounts")
}

enum PlanKode {
  free
  monthly
  semester
  school
}

model Plan {
  id         String   @id @default(uuid()) @db.Uuid
  kode       PlanKode
  subjectId  String?  @map("subject_id") @db.Uuid
  nama       String
  harga      Int
  /// null untuk plan `school` — masa berlakunya ikut School.validUntil, bukan durasi tetap.
  durasiHari Int?     @map("durasi_hari")
  fitur      Json?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  subject       Subject?       @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  invoices      Invoice[]
  entitlements  Entitlement[]
  vouchers      Voucher[]
  voucherOrders VoucherOrder[]

  @@map("plans")
}

enum InvoiceStatus {
  pending
  paid
  expired
  refunded
}

/// Jalur A saja (siswa individu via payment gateway Midtrans). Jalur B tidak
/// pernah membuat invoice (aktivasi kursi sekolah = aksi admin langsung ke
/// entitlements), Jalur C tidak pernah membuat invoice (redeem voucher
/// langsung ke entitlements) — lihat lib/billing/jalur-b.ts & jalur-c.ts.
model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  studentId      String        @map("student_id") @db.Uuid
  planId         String        @map("plan_id") @db.Uuid
  subjectId      String?       @map("subject_id") @db.Uuid
  amount         Int
  status         InvoiceStatus @default(pending)
  gatewayRef     String?       @unique @map("gateway_ref")
  paymentChannel String?       @map("payment_channel")
  expiresAt      DateTime      @map("expires_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  plan         Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  subject      Subject?      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  entitlements Entitlement[]

  @@map("invoices")
}

enum EntitlementSource {
  invoice
  voucher
  school_seat
}

/// Sumber kebenaran tunggal untuk "apakah siswa ini boleh akses tryout
/// sekarang?" — apa pun jalur pembayarannya. HANYA dibaca lewat
/// getActiveEntitlement(studentId) di lib/billing/entitlements.ts, tidak ada
/// logika cek akses lain yang ditulis ulang di tempat lain.
model Entitlement {
  id         String            @id @default(uuid()) @db.Uuid
  studentId  String            @map("student_id") @db.Uuid
  planId     String            @map("plan_id") @db.Uuid
  startsAt   DateTime          @map("starts_at")
  endsAt     DateTime          @map("ends_at")
  /// Bagian 6.3: selesai ends_at siswa masih boleh lihat riwayat lama sampai
  /// grace_until, tapi tidak boleh mulai tryout baru.
  graceUntil DateTime?         @map("grace_until")
  source     EntitlementSource
  invoiceId  String?           @map("invoice_id") @db.Uuid
  voucherId  String?           @map("voucher_id") @db.Uuid
  schoolId   String?           @map("school_id") @db.Uuid
  revokedAt  DateTime?         @map("revoked_at")
  createdAt  DateTime          @default(now()) @map("created_at")

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan    Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  voucher Voucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  school  School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([studentId, revokedAt, startsAt, endsAt])
  @@map("entitlements")
}

enum VoucherStatus {
  unused
  used
  void
}

/// Jalur C: batch dibuat admin pusat manual (generatedBy=admin,
/// voucherOrderId=null) ATAU mitra beli sendiri lewat Midtrans
/// (generatedBy=mitra sendiri, voucherOrderId terisi - lihat VoucherOrder).
/// Redeem oleh siswa langsung tulis entitlements, TIDAK pernah membuat
/// invoice siswa.
model Voucher {
  id              String        @id @default(uuid()) @db.Uuid
  code            String        @unique
  planId          String        @map("plan_id") @db.Uuid
  partnerId       String        @map("partner_id") @db.Uuid
  status          VoucherStatus @default(unused)
  usedByStudentId String?       @map("used_by_student_id") @db.Uuid
  usedAt          DateTime?     @map("used_at")
  generatedById   String        @map("generated_by_id") @db.Uuid
  voucherOrderId  String?       @map("voucher_order_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")

  plan          Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  partner       Partner       @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  usedByStudent Student?      @relation(fields: [usedByStudentId], references: [id], onDelete: SetNull)
  generatedBy   User          @relation("VoucherGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)
  voucherOrder  VoucherOrder? @relation(fields: [voucherOrderId], references: [id], onDelete: SetNull)
  entitlements  Entitlement[]

  @@map("vouchers")
}

enum VoucherOrderStatus {
  pending
  paid
  expired
}

/// Jalur C lewat Midtrans: mitra beli N voucher sekaligus untuk satu plan,
/// bayar sendiri (harga = plan.harga × jumlah - harga penuh, sama seperti
/// siswa individu; mitra cari untung dari selisih harga jual mereka sendiri
/// ke siswa, di luar sistem). Begitu lunas (webhook sama dengan Jalur A di
/// app/api/webhooks/midtrans), sistem generate N kode voucher otomatis.
model VoucherOrder {
  id             String             @id @default(uuid()) @db.Uuid
  partnerId      String             @map("partner_id") @db.Uuid
  planId         String             @map("plan_id") @db.Uuid
  jumlah         Int
  amount         Int
  status         VoucherOrderStatus @default(pending)
  gatewayRef     String?            @unique @map("gateway_ref")
  paymentChannel String?            @map("payment_channel")
  expiresAt      DateTime           @map("expires_at")
  createdAt      DateTime           @default(now()) @map("created_at")

  partner  Partner   @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  vouchers Voucher[]

  @@map("voucher_orders")
}

/// Bagian A (permintaan user): skema diskon grosir mitra beli voucher -
/// dulu hardcoded di kode (VOUCHER_PRICE_TIERS), sekarang bisa diatur admin
/// pusat kapan saja tanpa deploy ulang. Dicek dari minJumlah PALING TINGGI
/// dulu (lihat lib/billing/voucher-pricing.ts) - jumlah di bawah tier
/// terendah dapat 0% (tidak perlu baris tersendiri untuk itu).
model VoucherPriceTier {
  id           String @id @default(uuid()) @db.Uuid
  minJumlah    Int    @unique @map("min_jumlah")
  diskonPersen Int    @map("diskon_persen")
  label        String

  @@map("voucher_price_tiers")
}

enum SaldoTransactionTipe {
  topup
  debit_analisis
  penyesuaian_admin
}

enum SaldoTransactionStatus {
  pending
  berhasil
  gagal
}

/// Bagian D/G (permintaan user): dompet/saldo siswa untuk membeli Learning
/// Analytics tambahan di luar jatah plan. Saldo = SUM(jumlah) atas baris
/// berstatus "berhasil" milik siswa ini (bukan kolom saldo terpisah yang
/// bisa drift - lihat lib/billing/saldo.ts). jumlah SIGNED: positif untuk
/// kredit (topup, penyesuaian tambah admin), negatif untuk debit (dipakai
/// analisis, penyesuaian kurang admin).
model SaldoTransaction {
  id             String                 @id @default(uuid()) @db.Uuid
  studentId      String                 @map("student_id") @db.Uuid
  tipe           SaldoTransactionTipe
  status         SaldoTransactionStatus
  jumlah         Int
  keterangan     String?
  gatewayRef     String?                @unique @map("gateway_ref")
  paymentChannel String?                @map("payment_channel")
  expiresAt      DateTime?              @map("expires_at")
  createdById    String?                @map("created_by_id") @db.Uuid
  createdAt      DateTime               @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("saldo_transactions")
}

/// Mitra/reseller — punya login sendiri (userId, role mitra) dan dashboard
/// read-only jumlah voucher terpakai per batch. Bagian 6.5: tidak pernah
/// melihat NISN/nama lengkap siswa yang pakai vouchernya.
model Partner {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  nama         String
  kontak       String?
  referralCode String   @unique @map("referral_code")
  createdAt    DateTime @default(now()) @map("created_at")

  user             User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  vouchers         Voucher[]
  voucherOrders    VoucherOrder[]
  schools          School[]
  commissions      PartnerCommission[]
  referredStudents Student[]           @relation("StudentPartnerReferral")

  @@map("partners")
}

enum CommissionStatus {
  pending
  paid
}

/// Bagian 4.1: sekolah yang datang dari rujukan mitra tetap membayar &
/// diaktifkan lewat Jalur B tanpa perubahan — baris ini cuma jejak rujukan +
/// komisi. amount null sampai admin menetapkan nominal manual (tidak bisa
/// dihitung otomatis karena nilai kontrak sekolah hasil negosiasi per kasus).
/// Dibuat otomatis begitu School.seatQuota diaktifkan DAN
/// referredByPartnerId sudah terisi — TIDAK PERNAH retroaktif (Bagian 6.7).
model PartnerCommission {
  id        String           @id @default(uuid()) @db.Uuid
  partnerId String           @map("partner_id") @db.Uuid
  schoolId  String           @map("school_id") @db.Uuid
  amount    Int?
  status    CommissionStatus @default(pending)
  note      String?
  createdAt DateTime         @default(now()) @map("created_at")
  paidAt    DateTime?        @map("paid_at")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  school  School  @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@map("partner_commissions")
}

// ---------------------------------------------------------------------------
// Grup 21: login_logs, audit_logs
// ---------------------------------------------------------------------------

model LoginLog {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  ip       String?
  device   String?
  loginAt  DateTime  @default(now()) @map("login_at")
  logoutAt DateTime? @map("logout_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("login_logs")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  aksi       String
  entitas    String
  entitasId  String?  @map("entitas_id")
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Grup 22: stimulus, taxonomy_mappings, soal_import_logs — dokumen "Integrasi
// Bank Soal TKA": impor satu arah dari soal.ayotka.id, dipicu manual admin
// pusat. Semua aditif, tidak mengubah makna kolom lama.
// ---------------------------------------------------------------------------

enum StimulusTipe {
  teks
  data
}

/// Bacaan atau data yang dipakai bersama oleh beberapa Question (mis. teks
/// bacaan Bahasa Indonesia) - lihat Question.stimulusId. Tidak eksklusif
/// untuk soal hasil impor, Question mana pun boleh mereferensikan Stimulus.
model Stimulus {
  id        String       @id @default(uuid()) @db.Uuid
  tipe      StimulusTipe
  judul     String?
  konten    String
  createdAt DateTime     @default(now()) @map("created_at")

  questions Question[]

  @@map("stimulus")
}

/// Satu baris = satu kombinasi label taksonomi sumber (elemen/subElemen/
/// kompetensi versi soal.ayotka.id) yang sudah pernah dipetakan admin ke
/// Kompetensi ayotka-app. Dipetakan sekali lewat dropdown di preview impor,
/// dipakai ulang otomatis untuk paket berikutnya yang memakai label sama.
model TaxonomyMapping {
  id               String   @id @default(uuid()) @db.Uuid
  /// Selalu "soal-ayotka-id" untuk saat ini - field disiapkan untuk sumber
  /// impor lain di masa depan tanpa perlu migration baru.
  sumber           String
  sourceElemen     String   @map("source_elemen")
  sourceSubElemen  String?  @map("source_sub_elemen")
  sourceKompetensi String?  @map("source_kompetensi")
  kompetensiId     String   @map("kompetensi_id") @db.Uuid
  createdBy        String   @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  kompetensi Kompetensi @relation(fields: [kompetensiId], references: [id], onDelete: Restrict)
  creator    User       @relation("TaxonomyMappingCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  /// Jalur pencocokan Matematika (Bagian 07): elemen.
  @@index([sumber, sourceElemen])
  /// Jalur pencocokan Bahasa Indonesia (Bagian 07): kompetensi, bukan elemen.
  @@index([sumber, sourceKompetensi])
  @@map("taxonomy_mappings")
}

/// Mencatat paket sumber (soal.ayotka.id) yang sudah pernah ditarik ke
/// ayotka-app - satu baris per proses impor. sourcePaketId SENGAJA tidak
/// unique: admin boleh impor ulang paket yang sama secara eksplisit (Bagian
/// 10 kasus tepi #4 dokumen Integrasi Bank Soal TKA), tiap impor ulang jadi
/// baris + Package baru, bukan menimpa yang lama.
model SoalImportLog {
  id              String   @id @default(uuid()) @db.Uuid
  /// Id paket di database soal.ayotka.id - bukan uuid (format id mereka
  /// sendiri), jadi disimpan sebagai string biasa.
  sourcePaketId   String   @map("source_paket_id")
  sourcePaketCode String   @map("source_paket_code")
  packageId       String   @unique @map("package_id") @db.Uuid
  importedBy      String   @map("imported_by") @db.Uuid
  importedAt      DateTime @default(now()) @map("imported_at")

  package  Package @relation(fields: [packageId], references: [id], onDelete: Restrict)
  importer User    @relation("SoalImportLogImportedBy", fields: [importedBy], references: [id], onDelete: Restrict)

  @@index([sourcePaketId])
  @@map("soal_import_logs")
}
